<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Active Premium Users Checker</title>
<style>
  body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background: #fafafa;
    margin: 0;
    padding: 40px;
    display: flex;
    justify-content: center;
  }
  .container {
    background: #fff;
    padding: 32px 36px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    width: 640px;
  }
  h1 {
    font-size: 20px;
    margin-bottom: 4px;
    color: #222;
  }
  p.sub {
    color: #777;
    font-size: 13px;
    margin-top: 0;
    margin-bottom: 20px;
  }
  input[type="text"] {
    width: 100%;
    padding: 10px 12px;
    font-size: 14px;
    border: 1px solid #ddd;
    border-radius: 8px;
    box-sizing: border-box;
    margin-bottom: 20px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  th, td {
    text-align: left;
    padding: 8px 10px;
    border-bottom: 1px solid #eee;
  }
  th {
    color: #555;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
  }
  .premium-yes { background: #e6f4ea; color: #1a7f37; }
  .premium-no  { background: #f4e6e6; color: #a83232; }
  .active-yes  { background: #e6f0f4; color: #1a5e7f; }
  .active-no   { background: #f0f0f0; color: #888; }
  .no-results {
    color: #999;
    font-size: 13px;
    padding: 12px 0;
  }
  .today-note {
    font-size: 12px;
    color: #999;
    margin-top: 18px;
  }
</style>
</head>
<body>

<div class="container">
  <h1>Active Premium Users Checker</h1>
  <p class="sub">Reference date: <b>2024-06-10</b>. Showing premium status and last-login activity for a random set of users.</p>

  <input type="text" id="searchBox" placeholder="Search by username...">

  <table>
    <thead>
      <tr>
        <th>Username</th>
        <th>Premium</th>
        <th>Last Login</th>
        <th>Active (7 days)</th>
      </tr>
    </thead>
    <tbody id="userTableBody"></tbody>
  </table>
  <div id="noResults" class="no-results" style="display:none;">No users match your search.</div>

  <p class="today-note">"Active" = logged in on or after 2024-06-03 (7 days before the reference date).</p>
</div>

<script>
  // ---- Random sample user data ----
  const firstNames = ["alice","bob","carol","dave","erin","frank","grace","heidi","ivan","judy","mallory","niaj","olivia","peggy","sybil"];

  function randomDateWithinDays(baseDate, maxDaysBack) {
    const daysBack = Math.floor(Math.random() * maxDaysBack);
    const d = new Date(baseDate);
    d.setDate(d.getDate() - daysBack);
    return d.toISOString().split('T')[0]; // YYYY-MM-DD
  }

  const today = new Date('2024-06-10');

  const users = firstNames.map(name => ({
    username: name,
    isPremium: Math.random() < 0.5,       // random true/false
    lastLogin: randomDateWithinDays(today, 20) // random date within the last 20 days
  }));

  // ---- The actual filtering logic from the original task ----
  function getActivePremiumUsers(userList) {
    const sevenDaysAgo = new Date(today);
    sevenDaysAgo.setDate(today.getDate() - 7);

    return userList.filter(user => {
      const lastLoginDate = new Date(user.lastLogin);
      return user.isPremium && lastLoginDate >= sevenDaysAgo && lastLoginDate <= today;
    });
  }

  const activePremiumUsernames = new Set(getActivePremiumUsers(users).map(u => u.username));

  function isActive(user) {
    const sevenDaysAgo = new Date(today);
    sevenDaysAgo.setDate(today.getDate() - 7);
    const lastLoginDate = new Date(user.lastLogin);
    return lastLoginDate >= sevenDaysAgo && lastLoginDate <= today;
  }

  function renderTable(filterText) {
    const tbody = document.getElementById("userTableBody");
    const noResults = document.getElementById("noResults");
    tbody.innerHTML = "";

    const filtered = users.filter(u =>
      u.username.toLowerCase().includes(filterText.toLowerCase())
    );

    if (filtered.length === 0) {
      noResults.style.display = "block";
      return;
    }
    noResults.style.display = "none";

    filtered.forEach(user => {
      const active = isActive(user);
      const row = document.createElement("tr");
      row.innerHTML = `
        <td>${user.username}</td>
        <td><span class="badge ${user.isPremium ? 'premium-yes' : 'premium-no'}">${user.isPremium ? 'Yes' : 'No'}</span></td>
        <td>${user.lastLogin}</td>
        <td><span class="badge ${active ? 'active-yes' : 'active-no'}">${active ? 'Active' : 'Inactive'}</span></td>
      `;
      tbody.appendChild(row);
    });
  }

  document.getElementById("searchBox").addEventListener("input", (e) => {
    renderTable(e.target.value);
  });

  // Initial render
  renderTable("");
</script>

</body>
</html>

endstream
